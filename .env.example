# Database (required for compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=PvpAnalytics
POSTGRES_PAYMENT_DB=PaymentService
ORACLE_PASSWORD=YourStrongPassword123!

# JWT (required for auth and API)
JWT_SIGNING_KEY=your-signing-key-min-32-chars

# WoW API (optional; required for player enrichment)
WowApi__ClientId=
WowApi__ClientSecret=

# Kafka (Phase 5 streaming ingestion)
# Bootstrap servers; in compose use kafka:9092, locally use localhost:9092
Kafka__BootstrapServers=localhost:9092
Kafka__IngestionTopic=pvpanalytics.ingestion.matches
Kafka__IngestionDeadLetterTopic=pvpanalytics.ingestion.matches.dlq
# Consumer group (Worker only)
Kafka__GroupId=pvpanalytics-ingestion-consumer

# Feature flags: streaming ingestion
Ingestion__StreamingEnabled=true
Ingestion__StreamingConsumerEnabled=true
